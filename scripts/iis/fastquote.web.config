<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="true" />
        <windowsAuthentication enabled="false" />
      </authentication>
    </security>
    <modules runAllManagedModulesForAllRequests="true">
      <add name="WindowsUserHeaderModule" type="IisProxyAuth.WindowsUserHeaderModule, IisProxyAuth" />
    </modules>
    <rewrite>
      <rules>
        <!-- Planned-maintenance gate. While a `maintenance.flag` file exists in the IIS site
             root, serve maintenance.html for every request. The deploy script creates the flag
             before stopping Node and removes it once Node is back up. This REPLACES the old
             httpErrors existingResponse="Replace" trick, which also masked real application
             error bodies (400/401/409/429/500 JSON) and broke client-side error handling.
             Unplanned crashes are covered by PM2's own auto-restart (a brief blip), not here. -->
        <rule name="Maintenance Mode" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{DOCUMENT_ROOT}/maintenance.flag" matchType="IsFile" />
            <add input="{URL}" pattern="^/maintenance\.html$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/maintenance.html" />
        </rule>
        <rule name="FastQuote Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_WINDOWS_USER" value="" />
            <set name="HTTP_X_USER_ID" value="" />
            <set name="HTTP_X_ASPNET_USER_ID" value="" />
            <set name="HTTP_X_ASPNET_USERID" value="" />
            <set name="HTTP_X_USERID" value="" />
            <set name="HTTP_X_MS_CLIENT_PRINCIPAL_ID" value="" />
            <set name="HTTP_X_AUTHENTICATED_USERID" value="" />
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- existingResponse="PassThrough": return the Node backend's OWN response body for every
         status code, so client-side error handling can read {ok:false,error,...} (e.g. the
         services-location prompt's 400 {requiresServicesLocation:true}). Do NOT change this back
         to "Replace" — that masks every backend error with IIS's stock "Bad Request" HTML page
         and silently breaks all app error handling. Maintenance during deploys is handled by the
         "Maintenance Mode" rewrite rule above (flag-file gate), not here. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
  <location path="api/me">
    <system.webServer><security><authentication>
      <anonymousAuthentication enabled="false" />
      <windowsAuthentication enabled="true" />
    </authentication></security></system.webServer>
  </location>
  <location path="api/sso">
    <system.webServer><security><authentication>
      <anonymousAuthentication enabled="false" />
      <windowsAuthentication enabled="true" />
    </authentication></security></system.webServer>
  </location>
</configuration>
